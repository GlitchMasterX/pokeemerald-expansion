    speakername("???")
    msgbox(format("{COLOR BLUE}{SHADOW LIGHT_GRAY}I'm honored to fight alongside you, Rayquaza!"))
    closemessage
    applymovement(11,moves(jump_in_place_up*2))
    speakername("???")
    msgbox(format("{COLOR BLUE}{SHADOW LIGHT_GRAY}Let's do this, My friend!"))
    closemessage
    playmoncry(SPECIES_RAYQUAZA, CRY_MODE_HIGH_PITCH)
    setvar(VAR_0x8004,4)
	setvar(VAR_0x8005,4)
	setvar(VAR_0x8006,4)
	setvar(VAR_0x8007,4)	
	special(ShakeCamera)
    waitmoncry
    delay(20)
    warp(MAP_PLAYERROOM,2,5) 
}