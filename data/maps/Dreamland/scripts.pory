script  Cityruin_8 {
    lock
    special(SpawnCameraObject)
    applymovement(0xFF,moves(set_invisible))
    givemon(SPECIES_VOLCARONA,100,ITEM_HEAVY_DUTY_BOOTS,ITEM_POKE_BALL,NATURE_MODEST,1,MON_MALE,0,0,0,252,252,4,31,0,31,31,31,31, MOVE_BUG_BUZZ,MOVE_FIERY_DANCE,MOVE_QUIVER_DANCE,MOVE_MORNING_SUN)
    givemon(SPECIES_GARCHOMP,97,ITEM_ROCKY_HELMET,ITEM_POKE_BALL,NATURE_JOLLY,1,MON_MALE,0,252,0,252,0,4,31,31,31,31,31,31, MOVE_EARTHQUAKE,MOVE_DRAGON_CLAW,MOVE_STONE_EDGE,MOVE_SWORDS_DANCE)
    givemon(SPECIES_KELDEO,100,ITEM_LIFE_ORB,ITEM_POKE_BALL,NATURE_TIMID,1,MON_GENDERLESS,0,0,0,252,252,4,31,31,31,31,31,31, MOVE_CALM_MIND,MOVE_SCALD,MOVE_SACRED_SWORD,MOVE_ICY_WIND)
    givemon(SPECIES_STARAPTOR,95,ITEM_CHOICE_BAND,ITEM_POKE_BALL,NATURE_JOLLY,2,MON_MALE,0,252,0,252,0,4,31,31,31,31,31,31, MOVE_BRAVE_BIRD,MOVE_DEFOG,MOVE_CLOSE_COMBAT,MOVE_DOUBLE_EDGE)
    givemon(SPECIES_SCIZOR,100,ITEM_SCIZORITE,ITEM_POKE_BALL,NATURE_ADAMANT,1,MON_MALE,0,112,136,76,0,184,31,31,31,31,31,31, MOVE_BULLET_PUNCH,MOVE_BUG_BITE,MOVE_AGILITY,MOVE_AERIAL_ACE)
    givemon(SPECIES_CLEFABLE,98,ITEM_LEFTOVERS,ITEM_POKE_BALL,NATURE_CALM,2,MON_FEMALE,252,0,0,0,0,252,31,0,31,31,31,31, MOVE_SOFT_BOILED,MOVE_MOONBLAST,MOVE_THUNDER_WAVE,MOVE_CALM_MIND)
    setflag(FLAG_BADGE01_GET)
    setflag(FLAG_BADGE02_GET)
    setflag(FLAG_BADGE03_GET)
    setflag(FLAG_BADGE04_GET)
    setflag(FLAG_BADGE05_GET)
    setflag(FLAG_BADGE06_GET)
    setflag(FLAG_BADGE07_GET)
    setflag(FLAG_BADGE08_GET)
    applymovement(5,invisible)
    msgbox(format("Aurther faced Veylor in the ruins of what was once a city."))
    closemessage
    fadescreen(FADE_FROM_BLACK)
    applymovement(0x7F,moves(walk_slow_down*6))
    waitmovement(0)
    playse(SE_PIN)
    applymovement(3,moves(emote_exclamation_mark))
    speakername("Veylor")
    msgbox(format("{PLAY_BGM}{MUS_PMD_DARK_CRATER}{CREATE_MUGSHOT}{MUGSHOT_VEYLOR}{EMOTE_NORMAL}{COLOR RED}{SHADOW LIGHT_GRAY}...You're here at last.\pI'VE BEEN WAITING, {COLOR BLUE}{SHADOW LIGHT_GRAY}AURTHER{COLOR RED}{SHADOW LIGHT_GRAY}.\pHow did you like {COLOR RED}the gift of War?\pIsn't it...{PAUSE_UNTIL_PRESS} magnificent?"))
    closemessage
    playse(SE_PIN)
    applymovement(4,moves(emote_upset))
    speakername("Aurther")
    msgbox(format("{CREATE_MUGSHOT}{MUGSHOT_AURTHER}{EMOTE_MAD}{COLOR BLUE}{SHADOW LIGHT_GRAY}Magnificent?\pEntire villages lie in ashes. Rivers run red with the blood of the innocent.\pAnd you have the audacity to call this a {COLOR RED}{SHADOW LIGHT_GRAY}gift?"))
    closemessage
    delay(20)
    speakername("Veylor")
    msgbox(format("{CREATE_MUGSHOT}{MUGSHOT_VEYLOR}{EMOTE_NORMAL}{COLOR RED}{SHADOW LIGHT_GRAY}It matters not... Nothing does.\pThose souls would have returned to dust regardless.\pThat is the ultimate truth of existence...{PAUSE_UNTIL_PRESS} the beautiful futility of it all.\pBut fear not... My Master shall guide what remains."))
    closemessage
    delay(20)
    speakername("Aurther")
    msgbox(format("{CREATE_MUGSHOT}{MUGSHOT_AURTHER}{EMOTE_MAD}{COLOR BLUE}{SHADOW LIGHT_GRAY}Your Master's reign ends today.\pI will cut down both you and your false god, and this war will die with you."))
    closemessage
    playse(SE_PIN)
    applymovement(3,moves(emote_happy))
    applymovement(4,moves(emote_exclamation_mark))
    speakername("Veylor")
    msgbox(format("{CREATE_MUGSHOT}{MUGSHOT_VEYLOR}{EMOTE_JOY}{COLOR RED}{SHADOW LIGHT_GRAY}Heh...{PAUSE_UNTIL_PRESS}Hahaha...\p{COLOR RED}{SHADOW LIGHT_GRAY}HAHAHAHAHA!\pYOU TRULY BELIEVE YOU CAN END THIS?"))
    closemessage
    playse(SE_PIN)
    applymovement(3,moves(emote_upset))
    speakername("Veylor")
    msgbox(format("{CREATE_MUGSHOT}{MUGSHOT_VEYLOR}{EMOTE_MAD}{COLOR RED}{SHADOW LIGHT_GRAY}FOOL!\pEven should my blood water this ground...{PAUSE_UNTIL_PRESS} you will never touch Him.\pYou will understand, Aurther...{PAUSE_UNTIL_PRESS} when you stand before His glory...\pThe utter insignificance of your hope.\pThe crushing weight of your predetermined fate."))
    delay(25)
    speakername("Aurther")
    msgbox(format("{CREATE_MUGSHOT}{MUGSHOT_AURTHER}{EMOTE_MAD}{COLOR BLUE}{SHADOW LIGHT_GRAY}Then I will forge a new fate with my own hands.\pI will prove that even the smallest flame can banish endless darkness.\pAnd it starts...{PAUSE} by ending you."))
    closemessage
    playse(SE_PIN)
    applymovement(3,moves(jump_in_place_down*2))
    waitmovement(0)
    speakername("Veylor")
    msgbox(format("{CREATE_MUGSHOT}{MUGSHOT_VEYLOR}{EMOTE_JOY}{COLOR RED}{SHADOW LIGHT_GRAY}WONDERFUL! TRULY WONDERFUL!\pSUCH DEFIANCE! SUCH FIRE!\pIT WILL MAKE YOUR DESPAIR ALL THE MORE DELICIOUS TO SAVOR!\pCOME THEN, {COLOR BLUE}{SHADOW LIGHT_GRAY}ARTHUR!{COLOR RED}{SHADOW LIGHT_GRAY}HERO OF THE HOPEFUL!\pLET'S SEE IF YOUR HOPE BURNS BRIGHTER THAN THE TRUTH!\pHOOPA!!!"))
    closemessage
    playse(SE_CLICK)
    applymovement(3,moves(veylor_special))
    applymovement(0x7F,moves(walk_slow_up*2))
    applymovement(1,moves(emote_upset jump_in_place_down*2))
    playmoncry(SPECIES_HOOPA_UNBOUND, CRY_MODE_HIGH_PITCH)
    setweather(WEATHER_BLIZZARD)
    doweather
    playse(SE_M_TELEPORT)
    applymovement(2,portal_open)
    waitse
    waitmovement(0)
    playse(SE_WARP_OUT)
    createvobject(OBJ_EVENT_GFX_DIALGA_FRONT,30,39,18,3,DIR_SOUTH)
    delay(20)
    playse(SE_M_TELEPORT)
    applymovement(2,portal_close)
    waitse
    waitmovement(0)
    applymovement(2,moves(walk_faster_right*6))
    playmoncry(SPECIES_DIALGA, CRY_MODE_HIGH_PITCH)
    setvar(VAR_0x8004,4)
	setvar(VAR_0x8005,4)
	setvar(VAR_0x8006,4)
	setvar(VAR_0x8007,4)	
	special(ShakeCamera)
    waitmoncry
    waitmovementall
    playse(SE_M_TELEPORT)
    applymovement(2,portal_open)
    waitse
    waitmovement(0)
    playse(SE_WARP_OUT)
    applymovement(5,visible)
    delay(20)
    playse(SE_M_TELEPORT)
    applymovement(2,portal_close)
    waitse
    waitmovement(0)
    applymovement(2,moves(walk_faster_right*6))
    playmoncry(SPECIES_PALKIA, CRY_MODE_HIGH_PITCH)
    setvar(VAR_0x8004,4)
	setvar(VAR_0x8005,4)
	setvar(VAR_0x8006,4)
	setvar(VAR_0x8007,4)	
	special(ShakeCamera)
    waitmoncry
    callnative(Backup_Player_Name)
    setvar(VAR_CHANGE_NAME,0)
    setflag(FLAG_CHANGE_NAME)
    callnative(ForceSetPlayerName_FromAltName)
    msgbox(format("You'll be playing as Aurther.\pHere's a gift."))
    closemessage
    giveitem(ITEM_MEGA_RING,1)
    msgbox(format("Good luck!"))
    closemessage
    setflag(FLAG_NO_WHITEOUT)
    setflag(FLAG_SYS_SET_BATTLE_BGM)
    setvar(VAR_TEMP_D,MUS_PMD_VS_DUSKNOIR)
    trainerbattle_no_intro(VEYLOR_1, veylorlose)
    delay(10)
    clearflag(FLAG_NO_WHITEOUT)
    playse(SE_PIN)
    applymovement(3,moves(emote_exclamation_mark))
    waitmovement(0)
    playse(SE_BANG)
    applymovement(3,moves(slide_left*4))
    waitmovement(0)
    speakername("Veylor")
    msgbox(format("U-ugh... H-Hydreigon! Use Fly!"))
    closemessage
    playmoncry(SPECIES_HYDREIGON, CRY_MODE_HIGH_PITCH)
    fadescreen(FADE_TO_BLACK)
    removeobject(3)
    msgbox(format("Veylor fled that day.\pNo one knows where."))
    closemessage
    fadescreen(FADE_FROM_BLACK)
    applymovement(4,moves(walk_up*4))
    waitmovementall
    msgbox(format("Aurther stood before Hoopa.\pThe Prison Bottle rested in his grasp.\pA relic meant to command."))
    closemessage
    setvar(VAR_0x8000,0)
    callnative(OpenScreenshotsFromScript)
    delay(20)
    speakername("Hoopa")
    msgbox(format("{CREATE_MUGSHOT}{MUGSHOT_UNBOUND}{EMOTE_MAD}{COLOR LIGHT_RED}{SHADOW LIGHT_GRAY}..."))
    closemessage
    playmoncry(SPECIES_HOOPA_UNBOUND, CRY_MODE_HIGH_PITCH)
    setvar(VAR_0x8004,4)
    setvar(VAR_0x8005,4)
    setvar(VAR_0x8006,4)
    setvar(VAR_0x8007,4)
    special(ShakeCamera)
    waitmoncry
    fadescreen(FADE_TO_BLACK)
    msgbox(format("The world expected him to seal it.\pTo bend its power to his will."))
    closemessage
    fadescreen(FADE_FROM_BLACK)
    speakername("Aurther")
    msgbox(format("{CREATE_MUGSHOT}{MUGSHOT_AURTHER}{EMOTE_NORMAL}{COLOR BLUE}{SHADOW LIGHT_GRAY}You've suffered long enough.\pI won't prolong your suffering."))
    closemessage
    playse(SE_PIN)
    applymovement(1,moves(emote_exclamation_mark))
    speakername("Hoopa")
    msgbox(format("{CREATE_MUGSHOT}{MUGSHOT_UNBOUND}{EMOTE_SHOCK}{COLOR LIGHT_RED}{SHADOW LIGHT_GRAY}..."))
    closemessage
    fadescreen(FADE_TO_BLACK)
    msgbox(format("Instead of chains…\pAurther offered trust.\pAnd Hoopa answered."))
    closemessage
    msgbox(format("From that moment on,\pHoopa's power no longer stood alone.\pIt echoed the will of the man who freed it."))
    closemessage
    msgbox(format("But the war was not truly over.\pFor one final confrontation remained."))
    closemessage
    fadescreen(FADE_FROM_BLACK)
    clearflag(FLAG_BADGE01_GET)
    clearflag(FLAG_BADGE02_GET)
    clearflag(FLAG_BADGE03_GET)
    clearflag(FLAG_BADGE04_GET)
    clearflag(FLAG_BADGE05_GET)
    clearflag(FLAG_BADGE06_GET)
    clearflag(FLAG_BADGE07_GET)
    clearflag(FLAG_BADGE08_GET)
    removeitem(ITEM_MEGA_RING,1)
    callnative(ZeroPlayerPartyMons)
    fadescreen(FADE_TO_BLACK)
    clearflag(FLAG_SYS_SET_BATTLE_BGM)
    clearflag(FLAG_FLASHBACK_MUSIC)
    warp_continue_script(MAP_OLDALE_TOWN_POKEMON_CENTER_2F,10,10,Cityruin_9) 
}

text veylorlose{
    format("Hehe...Haha...HAHAHAHAHA!")
}

script Cityruin_9 {
    lock
    applymovement(0xFF,moves(set_invisible))
    waitmovement(0)
    special(SpawnCameraObject)
    msgbox(format("Frozen Heights\pThe northernmost peak of Velanthis."))
    waitmessage
    closemessage
    fadescreen(FADE_FROM_BLACK)
    applymovement(2,moves(walk_slow_up*5))
    applymovement(3,moves(walk_slow_up*5))
    applymovement(0x7F,moves(walk_slow_up*4))
    waitmovementall
    fadescreen(FADE_TO_BLACK)
    msgbox(format("And there, standing in the storm...\pWas the one Veylor called Master..."))
    closemessage
    fadescreen(FADE_FROM_BLACK)  
    applymovement(0x7F,moves(walk_slow_up*2))
    waitmovement(0)
    speakername("???")
    msgbox(format("...\pIt seems that Veylor lost to you...."))
    closemessage
    delay(10)
    speakername("???")
    msgbox(format("You stand here as a hero…\nbut answer me this…\pdid you choose this path,{PAUSE_UNTIL_PRESS} or were you simply too weak to walk any other?"))
    closemessage
    playse(SE_PIN)
    applymovement(2,moves(emote_exclamation_mark))
    applymovement(1,moves(face_down))
    speakername("???")
    msgbox(format("Those who lack the strength to be cruel{PAUSE_UNTIL_PRESS} often call it goodness."))
    closemessage
    playse(SE_PIN)
    applymovement(2,moves(emote_exclamation_mark))
    speakername("Aurther")
    msgbox(format("{CREATE_MUGSHOT}{MUGSHOT_AURTHER}{EMOTE_QUESTION}{COLOR BLUE}{SHADOW LIGHT_GRAY}You're…\pIt can't be…"))
    closemessage    
    fadescreen(FADE_TO_BLACK)
    speakername("???")
    msgbox(format("When the battle ends… tell me…\pWill the world remember what you saved…\pOr......"))
    closemessage
    playse(SE_EXIT)
    waitse
    playbgm(MUS_DUMMY,FALSE)
    msgbox(format("No one knows how the battle ended.\pBut when Aurther returned...\p...something in him had changed."))
    closemessage
    msgbox(format("Those who knew him best would later say...\pHe never smiled the same way again.\pAs if he'd glimpsed something…\p…something that hollowed him from within."))
    closemessage
    msgbox(format("But to the world, he was victorious.\pNexus Order fell.\pThe war ended.\pAnd Aurther was hailed as…\p{COLOR BLUE}{SHADOW LIGHT_GRAY}THE HERO OF VELANTHIS."))
    closemessage
    setflag(FLAG_FLASHBACK_MUSIC)
    setflag(FLAG_HIDE_MAP_NAME_POPUP)
    warp_continue_script(MAP_ASTRAVEIL_CITY,30,39,Cityruin_A)
}

script Cityruin_A {
    lock
    applymovement(0xFF,moves(set_invisible))
    waitmovement(0)
    fadescreen(FADE_FROM_BLACK)
    delay(10)
    playse(SE_APPLAUSE)
    applymovement(1,moves(emote_happy jump_in_place_right*2))
    applymovement(2,moves(emote_happy jump_in_place_right*2))
    applymovement(3,moves(emote_happy jump_in_place_left*2))
    applymovement(4,moves(emote_happy jump_in_place_left*2))
    applymovement(5,moves(emote_happy jump_in_place_left*2))
    applymovement(6,moves(emote_happy jump_in_place_left*2))
    waitmovementall
    msgbox(format("ALL HAIL AURTHER!"))
    closemessage
    applymovement(1,moves(emote_happy jump_in_place_right*2))
    applymovement(2,moves(emote_happy jump_in_place_right*2))
    applymovement(3,moves(emote_happy jump_in_place_left*2))
    applymovement(4,moves(emote_happy jump_in_place_left*2))
    applymovement(5,moves(emote_happy jump_in_place_left*2))
    msgbox(format("ALL HAIL HERO OF VELANTHIS!"))
    closemessage
    playse(SE_APPLAUSE)
    applymovement(1,moves(emote_happy))
    applymovement(2,moves(emote_happy))
    applymovement(3,moves(emote_happy))
    applymovement(4,moves(emote_happy))
    applymovement(5,moves(emote_happy))
    applymovement(6,moves(emote_happy))
    applymovement(7,moves(emote_happy))
    msgbox(format("LONG LIVE AURTHER!\nLONG LIVE OUR SAVIOR!"))
    closemessage
    waitmessage
    fadescreen(FADE_TO_BLACK)
    msgbox(format("Peace was finally restored."))
    closemessage
    warp_continue_script(MAP_HOSPITAL,57,4,Cityruin_B)
    }

script Cityruin_B {
    lock
    fadenewbgm(MUS_DUMMY)
    msgbox(format("2 years later..."))
    closemessage
    special(SpawnCameraObject)
    callnative(RestorePlayerName)
    clearflag(FLAG_CHANGE_NAME)
    applymovement(0xFF,moves(set_invisible))
    fadescreen(FADE_FROM_BLACK)
    playse(SE_PIN)
    applymovement(14,moves(emote_exclamation_mark))
    speakername("Nurse")
    msgbox(format("{COLOR RED}{SHADOW LIGHT_GRAY}Congratulations, it's a boy!"))
    closemessage
    applymovement(14,moves(walk_right))
    waitmovement(0)
    speakername("Baby")
    msgbox(format("{CREATE_MUGSHOT}{MUGSHOT_AURTHER}{EMOTE_SPECIAL}Wahh...Wahh"))
    closemessage
    playse(SE_PIN)
    applymovement(11,moves(emote_heart))
    speakername("???")
    msgbox(format("{CREATE_MUGSHOT}{MUGSHOT_ELYSIA}{EMOTE_SPECIAL}{COLOR RED}{SHADOW LIGHT_GRAY}He's so small... and perfect.\pWhat should we name him?"))
    closemessage
    waitmessage
    special(Do_Player_Name)
    waitstate
    speakername("Aurther")
    msgbox(format("{CREATE_MUGSHOT}{MUGSHOT_AURTHER}{EMOTE_JOY}{COLOR BLUE}{SHADOW LIGHT_GRAY}We'll name him {PLAYER}.\pHe's destined for great things.\pI can feel it."))
    closemessage
    waitmessage
    speakername("{PLAYER}")
    msgbox(format("{CREATE_MUGSHOT}{MUGSHOT_AURTHER}{EMOTE_SPECIAL}Hehe...hehe"))
    closemessage
    playse(SE_PIN)
    applymovement(11,moves(emote_heart))
    speakername("Mom")
    msgbox(format("{CREATE_MUGSHOT}{MUGSHOT_ELYSIA}{EMOTE_SPECIAL}{COLOR RED}{SHADOW LIGHT_GRAY}{PLAYER}... Our precious little {PLAYER}.\pWe'll protect you, always."))
    closemessage
    waitmessage
    speakername("Aurther")
    msgbox(format("{CREATE_MUGSHOT}{MUGSHOT_AURTHER}{EMOTE_JOY}{COLOR BLUE}{SHADOW LIGHT_GRAY}This world is full of challenges, but you won't face them alone.\pWe'll be with you, every step of the way.\pI promise...."))
    closemessage
    fadescreen(FADE_TO_BLACK)
    msgbox(format("A promise he would never break...\p...and never fulfill."))
    waitmessage
    closemessage
    msgbox(format("15 years later..."))
    closemessage
    clearflag(FLAG_FLASHBACK_MUSIC)
    clearflag(FLAG_HIDE_MAP_NAME_POPUP)
    warp(MAP_PLAYERROOM,2,5)   
}