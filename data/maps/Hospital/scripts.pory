script test1{
	lock
	applymovement(23,move23)
	waitmovement(0)
	playse(SE_PIN)
	msgbox(format("Glad to see you"),MSGBOX_DEFAULT)
	applymovement(0xFF,move25)
	msgbox(format("Glad to see you"))
	release
}
